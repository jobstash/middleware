# Recruiters conversations and inference run in the user's official ChatGPT/Claude app.
# This disables new legacy platform inference queues while retaining historical reads.
RECRUITERS_LOCAL_MCP=true
# Historical/shared service model identifiers; the local MCP runtime does not use these.
CAREER_CODEX_MODEL=gpt-6-sol
CAREER_OPENAI_MODEL=gpt-6-sol
CAREER_ANTHROPIC_MODEL=claude-sonnet-5
# Candidate website origin for exact-origin mutations and checkout returns.
RECRUITERS_PUBLIC_ORIGIN=
# Candidate-only Stripe billing. Never reuse shared recruiter/agency price IDs.
CANDIDATE_STRIPE_SECRET_KEY=
CANDIDATE_STRIPE_WEBHOOK_SECRET=
CANDIDATE_STRIPE_MONTHLY_PRICE_ID=
CANDIDATE_STRIPE_YEARLY_PRICE_ID=
# Non-provider assessment-data encryption and introduction signing; retain across restarts.
CAREER_DATA_PROTECTION_KEY=
# Private candidate originals. Keep the document ID key stable across restarts.
CAREER_DOCUMENT_ID_KEY=
CAREER_DOCUMENT_STORAGE=local
CAREER_DOCUMENT_LOCAL_DIRECTORY=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
