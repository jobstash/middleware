{
  "name": "middleware",
  "version": "0.1.5",
  "description": "The multi-purpose backend for the JobStash.xyz ecosystem",
  "author": "Obafemi Teminife",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "build": "nest build",
    "typecheck": "tsc --noEmit --incremental false",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,libs}/**/*.ts\" --fix --max-warnings 0",
    "test": "yarn typecheck && node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "yarn test --watch",
    "test:cov": "yarn test --coverage",
    "test:debug": "yarn typecheck && node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "yarn test --config ./test/jest-e2e.json",
    "test:postgres": "RUN_POSTGRES_INTEGRATION=1 yarn test --runInBand src/postgres",
    "db:validate:postgres": "node -r ts-node/register -r tsconfig-paths/register scripts/validate-postgres-projections.ts",
    "db:benchmark:postgres": "node -r ts-node/register -r tsconfig-paths/register scripts/benchmark-postgres-search.ts",
    "db:parity:postgres": "node -r ts-node/register -r tsconfig-paths/register scripts/compare-production-parity.ts",
    "db:parity:filters": "node -r ts-node/register -r tsconfig-paths/register scripts/compare-production-filter-parity.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.3.5",
    "@langchain/openai": "^1.8.0",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/bull": "^12.0.1",
    "@nestjs/cache-manager": "^12.0.3",
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/mapped-types": "^12.0.1",
    "@nestjs/passport": "^12.0.1",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "^3.1.0",
    "@privy-io/node": "^0.38.0",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/cli": "^3.8.2",
    "@sentry/nestjs": "11.11.0",
    "@sentry/node": "11.11.0",
    "@sentry/profiling-node": "11.11.0",
    "axios": "^1.21.0",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "cookie-session": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "etag": "^1.8.1",
    "ethers": "6.17.0",
    "express-basic-auth": "^1.2.1",
    "express-jwt": "^8.5.1",
    "express-session": "^1.19.0",
    "fast-sort": "^3.4.1",
    "fp-ts": "^2.16.11",
    "fuzzysort": "^4.0.2",
    "geoip-country": "5.0.202611040312",
    "helmet": "^8.3.0",
    "io-ts": "^2.2.22",
    "io-ts-human-reporter": "^0.1.2",
    "iron-session": "9.0.1",
    "joi": "^18.3.2",
    "js-convert-case": "^4.2.0",
    "js-tiktoken": "^1.0.21",
    "js-yaml": "^5.5.0",
    "keyv": "^6.1.0",
    "lodash": "^4.18.1",
    "mime": "^4.1.2",
    "nft.storage": "^7.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-magic-login": "^1.2.4",
    "patch-package": "^8.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "short-unique-id": "^5.3.2",
    "slugify": "^1.6.9",
    "sqids": "^0.3.0",
    "stripe": "^23.1.0",
    "transliteration": "^2.7.0",
    "ts-morph": "^28.0.0",
    "typeorm": "^1.1.2",
    "uuid": "^14.0.3",
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@fast-check/jest": "^2.3.0",
    "@golevelup/ts-jest": "^3.0.0",
    "@jest/globals": "^30.5.2",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.0",
    "@types/etag": "^1.8.4",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/lodash": "^4.17.27",
    "@types/multer": "^2.3.0",
    "@types/node": "24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "jest": "30.5.2",
    "jest-junit": "^17.0.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "webpack": "^5.112.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "reporters": [
      "default",
      "jest-junit"
    ],
    "rootDir": "./",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "isolatedModules": true
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/jest.setup.cjs"
    ],
    "roots": [
      "<rootDir>/src",
      "<rootDir>/scripts"
    ],
    "modulePaths": [
      "<rootDir>"
    ],
    "moduleDirectories": [
      "node_modules",
      "<rootDir>"
    ]
  },
  "optionalDependencies": {
    "psl": "^1.15.0"
  },
  "resolutions": {
    "**/ipfs-unixfs/protobufjs": "^7.6.6",
    "**/ipfs-core-utils/parse-duration": "^2.1.11",
    "geoip-country/ip-address": "^10.7.6",
    "bull/uuid": "^11.1.1",
    "**/@typescript-eslint/typescript-estree/minimatch": "^11.0.5",
    "**/@ts-morph/common/minimatch": "^11.0.5",
    "**/@eslint/config-array/minimatch": "^11.0.5",
    "eslint/minimatch": "^11.0.5",
    "**/test-exclude/minimatch": "^11.0.5",
    "**/test-exclude/glob": "^14.0.4",
    "**/@jest/reporters/glob": "^14.0.4",
    "**/jest-config/glob": "^14.0.4",
    "**/jest-runtime/glob": "^14.0.4"
  }
}
